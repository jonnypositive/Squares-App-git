# App host/port
APP_HOST=127.0.0.1
APP_PORT=8080

# SMTP provider settings
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your_api_key_or_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Sender settings
EMAIL_FROM=you@yourdomain.com
EMAIL_FROM_NAME=Football Squares by Jonny+
EMAIL_REPLY_TO=you@yourdomain.com
